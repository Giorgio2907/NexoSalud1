<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp" android:orientation="vertical" android:background="@color/fondo">
    <include layout="@layout/barra"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/TextoNexo" android:text="CMI EL PROGRESO" android:textSize="12sp" android:textColor="@color/verde" android:textStyle="bold"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" app:cardBackgroundColor="@color/verde" app:cardCornerRadius="16dp">
                <TextView android:id="@+id/resumen" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:text="Seguimiento interno" android:textColor="@color/blanco" android:textSize="24sp" android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton style="@style/BotonNexo" android:id="@+id/nueva" android:text="Nueva tarea"/>
            <TextView style="@style/TextoNexo" android:text="Tareas registradas" android:textSize="14sp" android:textColor="@color/tinta" android:textStyle="bold"/>
            <TextView style="@style/TextoNexo" android:id="@+id/vacio" android:text="Todavía no hay tareas. Pulsa Nueva tarea para registrar la primera." android:textSize="16sp" android:textColor="@color/tinta"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/lista"/>
            <TextView style="@style/TextoNexo" android:text="Avance 1 · Registro y consulta de tareas" android:textSize="12sp" android:textColor="@color/secundario"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
