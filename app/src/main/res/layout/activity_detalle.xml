<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp" android:orientation="vertical" android:background="@color/fondo">
    <include layout="@layout/barra"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/TextoNexo" android:id="@+id/codigo" android:text="Referencia" android:textSize="14sp" android:textColor="@color/verde" android:textStyle="bold"/>
            <TextView style="@style/TextoNexo" android:id="@+id/estado" android:text="Estado" android:textSize="16sp" android:textColor="@color/tinta" android:textStyle="bold"/>
            <TextView style="@style/TextoNexo" android:id="@+id/accion" android:text="Acción pendiente" android:textSize="24sp" android:textColor="@color/tinta" android:textStyle="bold"/>
            <TextView style="@style/TextoNexo" android:id="@+id/datos" android:text="Datos de la tarea" android:textSize="16sp" android:textColor="@color/tinta"/>
            <com.google.android.material.button.MaterialButton style="@style/BotonSecundario" android:id="@+id/volver" android:text="Volver a la bandeja"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
